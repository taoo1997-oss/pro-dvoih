{
  "name": "rsvp-backend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create wedding-rsvp",
    "db:migrate": "wrangler d1 execute wedding-rsvp --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute wedding-rsvp --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  },
  "allowScripts": {
    "esbuild@0.17.19": true,
    "sharp@0.33.5": true,
    "workerd@1.20250718.0": true
  }
}
